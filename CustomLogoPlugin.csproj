<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net9.0  -> Jellyfin 10.11.x  (ABI 10.11.0.0)
      net10.0 -> Jellyfin 12.0.x   (ABI 12.0.0.0)  [what was announced as "10.12"]
    -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Jellyfin.Plugin.CustomLogo</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.CustomLogo</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>false</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Jellyfin supplies these at runtime; never ship them next to the plugin. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    The two builds carry different version numbers on purpose. On a 12.0 server BOTH
    manifest entries pass the targetAbi filter, and Jellyfin then picks the highest
    version number (InstallationManager.GetCompatibleVersions orders descending), so
    the .NET 10 build must sort above the .NET 9 one. On a 10.11 server the 12.0 entry
    is filtered out by ABI and 2.0.0.0 is the only candidate.
  -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <FileVersion>2.0.2.0</FileVersion>
    <Version>2.0.2.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <AssemblyVersion>2.1.2.0</AssemblyVersion>
    <FileVersion>2.1.2.0</FileVersion>
    <Version>2.1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Jellyfin 10.11.x -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

  <!-- Jellyfin 12.0.x -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The HTML transform is internal but unit tested. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>gencss</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
